# ---------------------------------------------------------------------------
# Variables opcionales de docker compose.
# Copia este archivo como .env (en la raíz del repositorio) y ajusta lo que
# necesites. Si no existe .env, se usan los valores por defecto.
# ---------------------------------------------------------------------------

# Puertos en tu equipo. Cámbialos si ya están ocupados.
API_PORT=3000
# Aplicación web: 8080 en modo normal, 5173 en modo desarrollo.
WEB_PORT=8080

# Puerto de PostgreSQL en tu equipo. Solo se usa con docker-compose.db-access.yml;
# por defecto la base de datos no se publica.
DB_PORT=5432

# Contraseña de PostgreSQL. Solo se aplica la primera vez que se crea la base;
# para cambiarla después borra el volumen con: docker compose down -v
POSTGRES_PASSWORD=admin

# Secreto para firmar los tokens JWT (mínimo 16 caracteres).
JWT_SECRET=secreto-local-de-desarrollo-cambialo-en-produccion

# Crear la organización y usuarios de demostración al arrancar.
SEED_DEMO_DATA=true

# Orígenes permitidos por CORS (frontend).
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Solo en modo desarrollo (docker-compose.dev.yml): permite escanear IPs
# privadas y servicios de tu equipo mediante host.docker.internal.
ALLOW_PRIVATE_TARGETS=false

# Monitoreo continuo: el planificador reaudita los activos según la frecuencia
# que cada organización elige en Configuración. Ponlo en false para desactivarlo.
SCHEDULER_ENABLED=true

# Alertas: URL de la aplicación web (se usa en los enlaces de las notificaciones)
# y servidor de correo. Sin SMTP_HOST, los canales de correo se omiten.
# En modo desarrollo los correos van a Mailpit (http://localhost:8025).
APP_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SSPM Alertas <alertas@sspm.local>

# Verificación de propiedad de activos antes de escanearlos. Solo puede ponerse
# en false en modo desarrollo (docker-compose.dev.yml), p. ej. para laboratorio.
ASSET_VERIFICATION_REQUIRED=true

# Protección del inicio de sesión: bloqueo tras N fallos durante X minutos.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
