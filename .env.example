# ---------------------------------------------------------------------------
# Variables opcionales de docker compose.
# Copia este archivo como .env (en la raíz del repositorio) y ajusta lo que
# necesites. Si no existe .env, se usan los valores por defecto.
# ---------------------------------------------------------------------------

# Puerto de la API en tu equipo. Cámbialo si ya está ocupado.
API_PORT=3000

# Puerto de PostgreSQL en tu equipo. Solo se usa con docker-compose.db-access.yml;
# por defecto la base de datos no se publica.
DB_PORT=5432

# Contraseña de PostgreSQL. Solo se aplica la primera vez que se crea la base;
# para cambiarla después borra el volumen con: docker compose down -v
POSTGRES_PASSWORD=admin

# Secreto para firmar los tokens JWT (mínimo 16 caracteres).
JWT_SECRET=secreto-local-de-desarrollo-cambialo-en-produccion

# Crear la organización y usuarios de demostración al arrancar.
SEED_DEMO_DATA=true

# Orígenes permitidos por CORS (frontend).
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Solo en modo desarrollo (docker-compose.dev.yml): permite escanear IPs
# privadas y servicios de tu equipo mediante host.docker.internal.
ALLOW_PRIVATE_TARGETS=false
