// ---------------------------------------------------------------------------
// SSPM - SaaS Lite | Modelo de datos (Sprint 1)
// Tablas de la sección 6.2 del documento: users, organizations, assets, scans.
// Las tablas findings, risk_scores, reports y alerts se añadirán en sprints
// posteriores (Sprint 2 en adelante).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rol de un usuario dentro de su organización (tenant).
/// ADMIN   -> Administrador de TI: gestiona usuarios, activos y escaneos.
/// ANALYST -> Desarrollador / analista: registra activos y lanza escaneos.
/// VIEWER  -> Gerente: solo lectura (dashboard, reportes).
enum UserRole {
  ADMIN
  ANALYST
  VIEWER
}

/// Tipo de activo externo registrado (RF-01).
enum AssetType {
  DOMAIN
  IP
}

/// Tipo de escaneo soportado. En Sprint 1 solo se implementa PORT_SCAN (Nmap).
enum ScanType {
  PORT_SCAN
  WEB_HEADERS
  SSL_CERT
  SENSITIVE_PATHS
}

/// Severidad de un hallazgo (RF-08), alineada con los rangos de CVSS v3.1:
/// CRITICAL 9.0-10.0 | HIGH 7.0-8.9 | MEDIUM 4.0-6.9 | LOW 0.1-3.9 | INFO 0.0
enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// Familia del hallazgo, ligada al módulo que lo detecta.
enum FindingCategory {
  EXPOSED_SERVICE
  HTTP_HEADERS
  TLS_CERTIFICATE
  SENSITIVE_PATH
}

/// Estado de gestión de un hallazgo.
/// OPEN            -> detectado en el último escaneo del tipo correspondiente
/// RESOLVED        -> dejó de detectarse en un escaneo posterior
/// ACCEPTED        -> riesgo aceptado por la organización (no cuenta en el score)
/// FALSE_POSITIVE  -> descartado por el usuario
enum FindingStatus {
  OPEN
  RESOLVED
  ACCEPTED
  FALSE_POSITIVE
}

/// Ciclo de vida de un escaneo asíncrono.
enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Organización (tenant). Toda entidad de negocio cuelga de una organización
/// y cualquier consulta debe filtrarse por `organization_id`.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users     User[]
  assets    Asset[]
  scans     Scan[]
  scanPorts ScanPort[]
  findings  Finding[]

  @@map("organizations")
}

/// Usuario de la plataforma. Pertenece a exactamente una organización.
model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @unique @db.VarChar(254)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  fullName       String    @map("full_name") @db.VarChar(150)
  role           UserRole  @default(VIEWER)
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAssets   Asset[]      @relation("AssetCreatedBy")
  requestedScans  Scan[]       @relation("ScanRequestedBy")
  reviewedFindings Finding[]   @relation("FindingReviewedBy")

  @@index([organizationId])
  @@map("users")
}

/// Activo externo (dominio o IP pública) perteneciente a una organización.
model Asset {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  type                   AssetType
  /// Valor normalizado (dominio en minúsculas sin punto final, o IP canónica).
  value                  String    @db.VarChar(253)
  name                   String?   @db.VarChar(150)
  description            String?
  isActive               Boolean   @default(true) @map("is_active")
  /// El usuario declara que posee autorización para escanear este activo (sección 1.6.3).
  authorizationConfirmed Boolean   @default(false) @map("authorization_confirmed")
  authorizedAt           DateTime? @map("authorized_at") @db.Timestamptz(6)
  createdById            String?   @map("created_by_id") @db.Uuid
  lastScannedAt          DateTime? @map("last_scanned_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  scans        Scan[]
  scanPorts    ScanPort[]
  findings     Finding[]

  @@unique([organizationId, value])
  @@index([organizationId])
  @@map("assets")
}

/// Ejecución de un escaneo sobre un activo. Se procesa de forma asíncrona.
model Scan {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  assetId        String     @map("asset_id") @db.Uuid
  type           ScanType   @default(PORT_SCAN)
  status         ScanStatus @default(PENDING)
  requestedById  String?    @map("requested_by_id") @db.Uuid
  /// Dirección IP efectivamente escaneada (el dominio se resuelve y valida antes de lanzar Nmap).
  targetAddress  String?    @map("target_address") @db.VarChar(45)
  /// Parámetros de ejecución (argumentos de Nmap, perfil, timeout).
  parameters     Json?
  startedAt      DateTime?  @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?  @map("finished_at") @db.Timestamptz(6)
  /// Salida cruda de la herramienta (p. ej. XML de Nmap convertido a JSON).
  rawResult      Json?      @map("raw_result")
  /// Resumen estructurado (puertos abiertos, servicios, versiones).
  summary        Json?
  errorMessage   String?    @map("error_message")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation("ScanRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  ports        ScanPort[]
  /// Hallazgos detectados por última vez en este escaneo.
  findings     Finding[]

  @@index([organizationId, assetId])
  @@index([status, createdAt])
  @@map("scans")
}

/// Puerto/servicio detectado en un escaneo (RF-02 puertos, RF-03 versiones).
/// Se normaliza en tabla propia para poder consultar la superficie expuesta,
/// comparar escaneos (nuevos puertos abiertos) y alimentar los hallazgos del Sprint 2.
model ScanPort {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scanId         String   @map("scan_id") @db.Uuid
  assetId        String   @map("asset_id") @db.Uuid
  port           Int
  /// tcp | udp | sctp
  protocol       String   @db.VarChar(8)
  /// open | closed | filtered | unfiltered | open|filtered | closed|filtered
  state          String   @db.VarChar(20)
  reason         String?  @db.VarChar(40)
  serviceName    String?  @map("service_name") @db.VarChar(100)
  product        String?  @db.VarChar(200)
  version        String?  @db.VarChar(100)
  extraInfo      String?  @map("extra_info") @db.VarChar(255)
  /// ssl si el servicio va sobre TLS
  tunnel         String?  @db.VarChar(20)
  cpe            String[] @default([])
  /// Confianza de la detección de Nmap (0-10)
  confidence     Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan         Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([scanId, protocol, port])
  @@index([organizationId, assetId, state])
  @@map("scan_ports")
}

/// Hallazgo de seguridad sobre un activo (RF-08). Se deduplica entre escaneos
/// mediante `fingerprint` (regla + ubicación): un mismo problema detectado en
/// escaneos sucesivos es un único hallazgo con `first_seen_at`/`last_seen_at`.
model Finding {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  assetId        String          @map("asset_id") @db.Uuid
  /// Último escaneo en el que se detectó.
  lastScanId     String?         @map("last_scan_id") @db.Uuid
  category       FindingCategory
  /// Identificador de la regla del catálogo (p. ej. HDR-HSTS-MISSING).
  ruleId         String          @map("rule_id") @db.VarChar(60)
  severity       FindingSeverity
  /// Puntuación CVSS v3.1 de referencia asignada a la regla (0.0-10.0).
  cvssScore      Decimal?        @map("cvss_score") @db.Decimal(3, 1)
  status         FindingStatus   @default(OPEN)
  title          String          @db.VarChar(200)
  description    String
  recommendation String
  /// Dónde se detectó: "tcp/22", "https://host/", "https://host/.env"...
  location       String          @db.VarChar(500)
  /// Datos concretos que sustentan el hallazgo (cabeceras, fechas, versiones...).
  evidence       Json?
  /// sha256(ruleId + location) para deduplicar.
  fingerprint    String          @db.VarChar(64)
  firstSeenAt    DateTime        @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt     DateTime?       @map("resolved_at") @db.Timestamptz(6)
  reviewedById   String?         @map("reviewed_by_id") @db.Uuid
  reviewNote     String?         @map("review_note")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  lastScan     Scan?        @relation(fields: [lastScanId], references: [id], onDelete: SetNull)
  reviewedBy   User?        @relation("FindingReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([assetId, fingerprint])
  @@index([organizationId, status, severity])
  @@index([organizationId, assetId, category])
  @@map("findings")
}
