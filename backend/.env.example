# ---------------------------------------------------------------------------
# SSPM Backend - variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# ---------------------------------------------------------------------------

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Conexión a PostgreSQL (usada por Prisma y por la aplicación)
DATABASE_URL="postgresql://postgres:admin@localhost:5432/sspm_db?schema=public"

# Secreto para firmar los JWT (RNF-01). Usa un valor largo y aleatorio en producción:
#   openssl rand -base64 48
JWT_SECRET="cambia-este-secreto-en-produccion"
# Tiempo de vida del token de acceso (formato de `ms`/jsonwebtoken: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# Rondas de bcrypt para el hash de contraseñas
BCRYPT_ROUNDS=12

# Orígenes permitidos para CORS (separados por coma). Vacío = deshabilitado.
CORS_ORIGINS=http://localhost:5173

# Permitir registrar IPs privadas/reservadas como activos (solo para pruebas locales).
# El alcance del proyecto (sección 1.5/1.6) limita los escaneos a activos públicos.
ALLOW_PRIVATE_TARGETS=false
