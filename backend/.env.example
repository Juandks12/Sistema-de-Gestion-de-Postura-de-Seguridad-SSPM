# ---------------------------------------------------------------------------
# SSPM Backend - variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# ---------------------------------------------------------------------------

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Cadena de conexión PostgreSQL usada por Prisma
DATABASE_URL="postgresql://postgres:admin@localhost:5432/sspm_db?schema=public"

# Secreto para firmar los JSON Web Tokens (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Tiempo de vida del token de acceso (formato de la librería `ms`: 15m, 1h, 7d)
JWT_EXPIRES_IN=8h

# Coste de bcrypt para el hash de contraseñas
BCRYPT_SALT_ROUNDS=12

# Orígenes permitidos por CORS (separados por coma). Vacío = deshabilitado
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ---------------------------------------------------------------------------
# Motor de escaneo (Nmap)
# ---------------------------------------------------------------------------
# Binario de Nmap (debe estar instalado en el sistema o en la imagen Docker)
NMAP_PATH=nmap
# Procesar la cola de escaneos en este proceso
SCAN_WORKER_ENABLED=true
# Escaneos simultáneos en la instancia y por organización
SCAN_MAX_CONCURRENCY=2
SCAN_MAX_CONCURRENCY_PER_ORG=1
# Escaneos que una organización puede solicitar por hora
SCAN_MAX_PER_HOUR_PER_ORG=30
# Tiempo máximo por escaneo (segundos)
SCAN_TIMEOUT_SECONDS=600
# Frecuencia de revisión de la cola (milisegundos)
SCAN_POLL_INTERVAL_MS=5000
# Perfil de puertos: los N más comunes, o una lista explícita en SCAN_PORTS
SCAN_TOP_PORTS=1000
SCAN_PORTS=
# Temporización de Nmap: 0 (paranoico) a 5 (agresivo)
SCAN_TIMING_TEMPLATE=4
# Modo laboratorio: permite activos privados/loopback. NUNCA en producción.
ALLOW_PRIVATE_TARGETS=false

# ---------------------------------------------------------------------------
# Auditoría web (cabeceras HTTP, certificados TLS, rutas sensibles)
# ---------------------------------------------------------------------------
# Puertos HTTP/HTTPS a auditar (además de los detectados en el escaneo de puertos)
WEB_HTTP_PORTS=80
WEB_HTTPS_PORTS=443
# Tiempo máximo por petición (milisegundos)
WEB_REQUEST_TIMEOUT_MS=10000
# Peticiones simultáneas al comprobar rutas sensibles
WEB_PATHS_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Monitoreo continuo (sección 10.4)
# ---------------------------------------------------------------------------
# Ejecutar el planificador en este proceso
SCHEDULER_ENABLED=true
# Cada cuánto revisa qué activos toca reauditar (milisegundos)
SCHEDULER_INTERVAL_MS=60000
# Activos que encola como máximo en cada revisión
SCHEDULER_BATCH_SIZE=20

# ---------------------------------------------------------------------------
# Alertas (RF-10): correo y webhooks
# ---------------------------------------------------------------------------
# URL pública de la aplicación web, para los enlaces de las notificaciones
APP_URL=http://localhost:5173
# Servidor SMTP. Vacío = los canales de correo se omiten (estado SKIPPED)
SMTP_HOST=
SMTP_PORT=587
# true = TLS implícito (465); false = STARTTLS si el servidor lo ofrece
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SSPM Alertas <alertas@sspm.local>
# Tiempo máximo de cada envío por correo o webhook (milisegundos)
ALERT_DELIVERY_TIMEOUT_MS=10000
